# Copia este archivo a ".env" y cambia TODOS los valores.
# No subas .env a git. Evita comillas simples (') y espacios en las contraseñas.

# ── MySQL principal (bddatos) ────────────────────────────────────────────────
MYSQL_ROOT_PASSWORD=cambia-esta-root
APP_DB_USER=app_user
APP_DB_PASSWORD=cambia-esta-app
AUDIT_READER_PASSWORD=cambia-esta-lector

# ── MySQL de auditoría (bdauditoria) ─────────────────────────────────────────
AUDIT_ROOT_PASSWORD=cambia-esta-root-auditoria
AUDIT_WRITER_PASSWORD=cambia-esta-escritor

# ── Login ────────────────────────────────────────────────────────────────────
# Genera uno con:  python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=cambia-este-secreto-de-al-menos-32-caracteres
# true = confiar en la cabecera X-Forwarded-For para obtener la IP del cliente.
# Solo para la demo (permite simular IPs) o si hay un proxy inverso delante.
TRUST_PROXY=true

# ── Telegram ─────────────────────────────────────────────────────────────────
# Token de tu bot (el que te dio @BotFather) y el chat donde llegarán las alertas.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Agente ───────────────────────────────────────────────────────────────────
ZONA_HORARIA=America/Mexico_City
# Geolocalización de IPs (necesaria para "viaje imposible"). Usa ip-api.com.
GEOIP_HABILITADO=true
